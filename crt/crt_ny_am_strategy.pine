//@version=6
// CRT (Candle Range Theory) - NY AM session backtest for NQ
// C1 = range candle. C2 sweeps one side of C1 and CLOSES back inside C1.
// Bearish: C2 high > C1 high and C1 low < C2 close < C1 high -> short
// Bullish: C2 low < C1 low and C1 low < C2 close < C1 high -> long
// Entry at C2 close, stop at C2 wick, target = opposite side of C1.
// C2 must close inside the NY AM window. Flat at the time-exit hour.
// Key sweep filter: C2 must also sweep a key level and close back past it:
// PDH/PDL, PWH/PWL, Asia H/L (20:00-00:00 ET) or London H/L (02:00-05:00 ET).
// Use a 1m-15m NQ1! chart and switch "CRT timeframe" between 30 / 60 / 240.
strategy("CRT NY AM", overlay=true, slippage=1, commission_type=strategy.commission.cash_per_contract, commission_value=2.5)

crtTF       = input.timeframe("60", "CRT timeframe", options=["30", "60", "240"])
keyFilter   = input.string("Require key sweep", "Key sweep filter", ["Off", "Require key sweep", "Only NO key sweep"])
dirOpt      = input.string("Both", "Direction", options=["Both", "Long only", "Short only"])
useWkLvls   = input.bool(true, "Key levels: PWH/PWL", group="Key levels")
useDayLvls  = input.bool(true, "Key levels: PDH/PDL", group="Key levels")
useAsia     = input.bool(true, "Key levels: Asia H/L", group="Key levels")
useLondon   = input.bool(true, "Key levels: London H/L", group="Key levels")
asiaSess    = input.session("2000-0000", "Asia session (NY time)", group="Key levels")
londonSess  = input.session("0200-0500", "London session (NY time)", group="Key levels")
winStartH   = input.int(9, "Window start hour (NY)", minval=0, maxval=23, group="C2 close window")
winStartM   = input.int(30, "Window start minute", minval=0, maxval=59, group="C2 close window")
winEndH     = input.int(12, "Window end hour (NY)", minval=0, maxval=23, group="C2 close window")
winEndM     = input.int(0, "Window end minute", minval=0, maxval=59, group="C2 close window")
useTimeExit = input.bool(true, "Flatten at time-exit hour", group="Exits")
exitH       = input.int(16, "Time-exit hour (NY)", minval=0, maxval=23, group="Exits")
qty         = input.int(1, "Contracts", minval=1)
startDate   = input.time(timestamp("2015-01-01T00:00:00"), "Backtest start")
showTable   = input.bool(true, "Show stats table")

TZ = "America/New_York"

if timeframe.in_seconds() >= timeframe.in_seconds(crtTF)
    runtime.error("Chart timeframe must be lower than the CRT timeframe (use 1m-15m).")

// ---------- key levels ----------
f_sessHL(bool inS) =>
    var float sH = na
    var float sL = na
    float outH = na
    float outL = na
    if inS and not inS[1]
        sH := high
        sL := low
    else if inS
        sH := math.max(sH, high)
        sL := math.min(sL, low)
    if not inS and inS[1]
        outH := sH
        outL := sL
    [outH, outL]

[asiaH, asiaL] = f_sessHL(not na(time(timeframe.period, asiaSess, TZ)))
[lonH, lonL] = f_sessHL(not na(time(timeframe.period, londonSess, TZ)))

var float curDH = na
var float curDL = na
var float curWH = na
var float curWL = na
var float kPDH = na
var float kPDL = na
var float kPWH = na
var float kPWL = na
var float kAH = na
var float kAL = na
var float kLH = na
var float kLL = na

newDay = timeframe.change("1D")
newWeek = timeframe.change("1W")
if newDay
    kPDH := curDH
    kPDL := curDL
if newWeek
    kPWH := curWH
    kPWL := curWL
if not na(asiaH)
    kAH := asiaH
    kAL := asiaL
if not na(lonH)
    kLH := lonH
    kLL := lonL
curDH := newDay ? high : math.max(nz(curDH, high), high)
curDL := newDay ? low : math.min(nz(curDL, low), low)
curWH := newWeek ? high : math.max(nz(curWH, high), high)
curWL := newWeek ? low : math.min(nz(curWL, low), low)

// ---------- build CRT-timeframe candles from chart bars ----------
newHTF = timeframe.change(crtTF)

var float curH = na
var float curL = na
var float curC = na
var float c2H = na
var float c2L = na
var float c2C = na
var float c1H = na
var float c1L = na

if newHTF
    c1H := c2H
    c1L := c2L
    c2H := curH
    c2L := curL
    c2C := curC
    curH := high
    curL := low
else
    curH := math.max(nz(curH, high), high)
    curL := math.min(nz(curL, low), low)
curC := close

// C2 swept a level above (bearish) / below (bullish) and closed back past it
f_above(float lvl, bool on) => on and not na(lvl) and c2H >= lvl and lvl > c2C
f_below(float lvl, bool on) => on and not na(lvl) and c2L <= lvl and lvl < c2C

string bearLvl = ""
bearLvl := f_above(kLH, useLondon) ? "London H" : bearLvl
bearLvl := f_above(kAH, useAsia) ? "Asia H" : bearLvl
bearLvl := f_above(kPDH, useDayLvls) ? "PDH" : bearLvl
bearLvl := f_above(kPWH, useWkLvls) ? "PWH" : bearLvl
string bullLvl = ""
bullLvl := f_below(kLL, useLondon) ? "London L" : bullLvl
bullLvl := f_below(kAL, useAsia) ? "Asia L" : bullLvl
bullLvl := f_below(kPDL, useDayLvls) ? "PDL" : bullLvl
bullLvl := f_below(kPWL, useWkLvls) ? "PWL" : bullLvl

// ---------- signals ----------
// C2 close time == open time of the new CRT candle
nyMins = hour(time, TZ) * 60 + minute(time, TZ)
winFrom = winStartH * 60 + winStartM
winTo = winEndH * 60 + winEndM
inWin = nyMins > winFrom and nyMins <= winTo

valid = newHTF and inWin and time >= startDate and not na(c1H) and not na(c2H)
inside = c2C < c1H and c2C > c1L
bearCRT = valid and inside and c2H > c1H
bullCRT = valid and inside and c2L < c1L
outside = bearCRT and bullCRT

bearKey = bearLvl != ""
bullKey = bullLvl != ""
bearOK = keyFilter == "Off" or (keyFilter == "Require key sweep" ? bearKey : not bearKey)
bullOK = keyFilter == "Off" or (keyFilter == "Require key sweep" ? bullKey : not bullKey)
bearSig = bearCRT and not outside and bearOK and dirOpt != "Long only"
bullSig = bullCRT and not outside and bullOK and dirOpt != "Short only"

// stop price per trade, indexed by trade number (for R-multiple stats)
var array<float> tradeStops = array.new<float>()

flat = strategy.position_size == 0 and strategy.opentrades == 0
if flat and bearSig
    strategy.entry("Short", strategy.short, qty=qty)
    strategy.exit("Short x", "Short", stop=c2H, limit=c1L, comment_profit="TP", comment_loss="SL")
    array.push(tradeStops, c2H)
else if flat and bullSig
    strategy.entry("Long", strategy.long, qty=qty)
    strategy.exit("Long x", "Long", stop=c2L, limit=c1H, comment_profit="TP", comment_loss="SL")
    array.push(tradeStops, c2L)

exitNow = nyMins >= exitH * 60 and nyMins < exitH * 60 + 60
if useTimeExit and strategy.position_size != 0 and exitNow
    strategy.close_all(comment="Time")

if bearSig
    bl = label.new(bar_index, high, "CRT short" + (bearKey ? " | " + bearLvl : ""), size=size.tiny)
    label.set_style(bl, label.style_label_down)
    label.set_color(bl, color.new(color.red, 15))
    label.set_textcolor(bl, color.white)
if bullSig
    ul = label.new(bar_index, low, "CRT long" + (bullKey ? " | " + bullLvl : ""), size=size.tiny)
    label.set_style(ul, label.style_label_up)
    label.set_color(ul, color.new(color.green, 15))
    label.set_textcolor(ul, color.white)

// ---------- R-multiple stats (commission included) ----------
var int nTP = 0
var int nSL = 0
var int nTime = 0
var int nWin = 0
var float sumR = 0.0
var float grossWinR = 0.0
var float grossLossR = 0.0
var float sumPts = 0.0
var int counted = 0

while counted < strategy.closedtrades
    i = counted
    entP = strategy.closedtrades.entry_price(i)
    exP = strategy.closedtrades.exit_price(i)
    isL = strategy.closedtrades.size(i) > 0
    costPts = 2 * 2.5 / syminfo.pointvalue
    pts = (isL ? exP - entP : entP - exP) - costPts
    stp = i < array.size(tradeStops) ? array.get(tradeStops, i) : na
    risk = math.abs(entP - nz(stp, entP))
    r = risk > 0 ? pts / risk : 0.0
    cmt = strategy.closedtrades.exit_comment(i)
    nTP += cmt == "TP" ? 1 : 0
    nSL += cmt == "SL" ? 1 : 0
    nTime += cmt == "Time" ? 1 : 0
    nWin += r > 0 ? 1 : 0
    sumR += r
    sumPts += pts
    grossWinR += r > 0 ? r : 0.0
    grossLossR += r < 0 ? -r : 0.0
    counted += 1

var table t = table.new(position.top_right, 2, 11, bgcolor=color.new(color.black, 15), border_width=1)
f_row(int row, string a, string b) =>
    table.cell(t, 0, row, a, text_color=color.white, text_size=size.small)
    table.cell(t, 1, row, b, text_color=color.white, text_size=size.small)

if showTable and barstate.islast
    n = counted
    tfName = crtTF == "240" ? "4H" : crtTF == "60" ? "1H" : "30m"
    f_row(0, "CRT TF", tfName)
    f_row(1, "Key filter", keyFilter)
    f_row(2, "Trades", str.tostring(n))
    f_row(3, "Win rate", n > 0 ? str.tostring(100.0 * nWin / n, "#.0") + "%" : "-")
    f_row(4, "Target hit", str.tostring(nTP))
    f_row(5, "Stopped", str.tostring(nSL))
    f_row(6, "Time exit", str.tostring(nTime))
    f_row(7, "Avg R", n > 0 ? str.tostring(sumR / n, "#.00") : "-")
    f_row(8, "Total R", str.tostring(sumR, "#.0"))
    f_row(9, "PF (R)", grossLossR > 0 ? str.tostring(grossWinR / grossLossR, "#.00") : "-")
    f_row(10, "Avg pts", n > 0 ? str.tostring(sumPts / n, "#.0") : "-")
